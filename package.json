{
  "name": "msg",
  "version": "1.0.0",
  "description": "msg — proxy exits, isolated-browser sign-ins, account ledger and WorkBuddy credential import in one magpie plugin.",
  "license": "MIT",
  "type": "module",
  "main": "./index.mjs",
  "files": [
    "index.mjs",
    "lib",
    "page",
    "ui",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "magpie",
    "magpie-page",
    "magpie-plugin",
    "proxy",
    "provider",
    "sign-in",
    "browser-profile",
    "workbuddy"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fenyan5312/msg.git"
  },
  "bugs": {
    "url": "https://github.com/fenyan5312/msg/issues"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "dependencies": {
    "camoufox": "0.5.9",
    "fpgen-js": "1.3.0",
    "playwright-core": "1.62.0"
  },
  "magpie": {
    "icon": "https://raw.githubusercontent.com/fenyan5312/msg/main/assets/icon.svg",
    "page": {
      "title": "msg",
      "titles": {
        "zh": "msg",
        "zh-TW": "msg",
        "ja": "msg"
      },
      "file": "page/index.html",
      "icon": "assets/icon.svg",
      "service": {
        "port": 3492,
        "option": "port"
      }
    },
    "permissions": ["providers:list"],
    "options": {
      "port": 3492
    }
  },
  "scripts": {
    "test": "bun test"
  }
